# 依赖（ubuntu 服务器直接 npm install ws，不纳入项目配置）
node_modules/
package.json
package-lock.json

# 多地址监听配置（含 Telegram bot token / chat_id，仅 VPS 本地存在）
service/sodex-watch/config.json
service/HYPE-watch/config.json

# 门控状态文件（START WATCH 去重）
service/sodex-watch/.seen-addresses.json
service/HYPE-watch/.seen-addresses.json

# 发现系统：config 含 TG 凭据、log/ 含被观察地址，仅本地存在
service/sodex-discovery/config.json
service/sodex-discovery/log/
service/HYPE-discovery/config.json
service/HYPE-discovery/log/

# app 编排开关：服务器本地各自维护（默认值在 app/index.mjs，缺文件即默认 both on）
service/app/config.json

